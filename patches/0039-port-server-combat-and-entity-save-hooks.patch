diff --git a/src/main/java/yesman/epicfight/util/EntityPatchDataIO.java b/src/main/java/yesman/epicfight/util/EntityPatchDataIO.java
new file mode 100644
index 0000000..96cf209
--- /dev/null
+++ b/src/main/java/yesman/epicfight/util/EntityPatchDataIO.java
@@ -0,0 +1,22 @@
+package yesman.epicfight.util;
+
+import com.mojang.serialization.MapCodec;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.world.level.storage.ValueInput;
+import net.minecraft.world.level.storage.ValueOutput;
+
+/** Keep the root-level fields of entity patch saves readable by the existing patch API. */
+public final class EntityPatchDataIO {
+    // CompoundTag.CODEC always represents a map, including when there are no patch fields.
+    private static final MapCodec<CompoundTag> FIELDS = MapCodec.assumeMapUnsafe(CompoundTag.CODEC);
+
+    private EntityPatchDataIO() {}
+
+    public static void writeFields(ValueOutput output, CompoundTag fields) {
+        if (!fields.isEmpty()) output.store(FIELDS, fields);
+    }
+
+    public static CompoundTag readFields(ValueInput input) {
+        return input.read(FIELDS).orElseGet(CompoundTag::new);
+    }
+}
