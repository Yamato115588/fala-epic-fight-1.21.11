+package yesman.epicfight.world.capabilities.item;
+
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.world.entity.ai.attributes.AttributeModifier;
+import net.minecraft.world.entity.ai.attributes.Attributes;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.component.ItemAttributeModifiers;
+import net.minecraft.world.item.equipment.ArmorType;
+
+public record ArmorAttributes(ArmorType type, double defense) {
+    public static ArmorAttributes fromItem(Item item) {
+        var components = item.components();
+        var equippable = components.get(DataComponents.EQUIPPABLE);
+        if (equippable == null) {
+            return null;
+        }
+
+        ArmorType type = switch (equippable.slot()) {
+            case FEET -> ArmorType.BOOTS;
+            case LEGS -> ArmorType.LEGGINGS;
+            case CHEST -> ArmorType.CHESTPLATE;
+            case HEAD -> ArmorType.HELMET;
+            case BODY -> ArmorType.BODY;
+            default -> null;
+        };
+        if (type == null) {
+            return null;
+        }
+
+        boolean hasArmor = false;
+        double defense = 0.0D;
+        var attributes = components.getOrDefault(DataComponents.ATTRIBUTE_MODIFIERS, ItemAttributeModifiers.EMPTY);
+        for (var entry : attributes.modifiers()) {
+            if (entry.attribute().equals(Attributes.ARMOR) && entry.slot().test(equippable.slot())) {
+                hasArmor = true;
+                if (entry.modifier().operation() == AttributeModifier.Operation.ADD_VALUE) {
+                    defense += entry.modifier().amount();
+                }
+            }
+        }
+        return hasArmor ? new ArmorAttributes(type, defense) : null;
+    }
+}
