+    }
+
+    private static RenderPipeline entityEffectPipeline(String name, VertexFormat.Mode mode) {
+        return copyPipeline(RenderPipelines.ENTITY_TRANSLUCENT, name, mode)
+            .withDepthTestFunction(EQUAL_DEPTH_TEST).withDepthWrite(false).withCull(false).build();
+    }
+
+    private static RenderPipeline whiteAfterimagePipeline(String name, VertexFormat.Mode mode) {
+        return copyPipeline(RenderPipelines.TRANSLUCENT_PARTICLE, name, mode)
+            .withDepthTestFunction(EQUAL_DEPTH_TEST).withDepthWrite(false).withCull(false).build();
+    }
