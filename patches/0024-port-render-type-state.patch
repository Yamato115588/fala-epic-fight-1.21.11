+public final class EpicFightRenderTypes {
+    private static final Identifier WHITE = id("textures/common/white.png");
+    private static final Identifier GLINT_WHITE = id("textures/entity/overlay/glint_white.png");
+
+    private static final Function<RenderPipeline, RenderPipeline> TRIANGLE_PIPELINE = Util.memoize(source ->
+        copyPipeline(source, "triangles/" + source.getLocation().getNamespace() + "/" + source.getLocation().getPath(), TRIANGLES).build());
+    private static final Function<RenderType, RenderType> TRIANGLE_TYPE = Util.memoize(EpicFightRenderTypes::makeTriangulated);
+
+    public static RenderType makeTriangulated(RenderType type) {
+        // Animated texture transforms, such as energy swirl, use this uncached path.
+        return type.mode() == TRIANGLES ? type : copyType(type, TRIANGLE_PIPELINE.apply(type.pipeline()), null);
+    }
+
+    public static RenderType getTriangulated(RenderType type) {
+        return type.mode() == TRIANGLES ? type : TRIANGLE_TYPE.apply(type);
+    }
+
+    private record TextureVariant(RenderType type, Identifier texture) {
+    }
+
+    private static final Function<TextureVariant, RenderType> TEXTURE_VARIANT = Util.memoize(variant ->
+        copyType(variant.type(), variant.type().pipeline(), variant.texture()));
+
+    public static RenderType replaceTexture(Identifier texture, RenderType type) {
+        RenderSetup.TextureBinding primary = type.state.textures.get("Sampler0");
+        return primary == null || primary.location().equals(texture) ? type : TEXTURE_VARIANT.apply(new TextureVariant(type, texture));
+    }
+
+    private static RenderType copyType(RenderType type, RenderPipeline pipeline, Identifier texture) {
+        RenderSetup source = type.state;
+        RenderSetup.RenderSetupBuilder copy = RenderSetup.builder(pipeline)
+            .setLayeringTransform(source.layeringTransform)
+            .setOutputTarget(source.outputTarget)
+            .setTextureTransform(source.textureTransform)
+            .setOutline(source.outlineProperty)
+            .bufferSize(type.bufferSize());
+        source.textures.forEach((slot, binding) ->
+            copy.withTexture(slot, texture != null && slot.equals("Sampler0") ? texture : binding.location(), binding.sampler()));
+        if (source.useLightmap) copy.useLightmap();
+        if (source.useOverlay) copy.useOverlay();
+        if (type.affectsCrumbling()) copy.affectsCrumbling();
+        if (type.sortOnUpload()) copy.sortOnUpload();
+        RenderType result = RenderType.create(type.name, copy.createRenderSetup());
+        if (pipeline.getVertexFormatMode() == TRIANGLES && result.outline().isPresent()) {
+            result.outline = result.outline().map(EpicFightRenderTypes::getTriangulated);
+        }
+        return result;
+    }
+
+    private static RenderPipeline.Builder copyPipeline(RenderPipeline source, String name, VertexFormat.Mode mode) {
+        return RenderPipeline.builder(new RenderPipeline.Snippet(
+                Optional.of(source.getVertexShader()), Optional.of(source.getFragmentShader()), Optional.of(source.getShaderDefines()),
+                Optional.of(source.getSamplers()), Optional.of(source.getUniforms()), source.getBlendFunction(),
+                Optional.of(source.getDepthTestFunction()), Optional.of(source.getPolygonMode()), Optional.of(source.isCull()),
+                Optional.of(source.isWriteColor()), Optional.of(source.isWriteAlpha()), Optional.of(source.isWriteDepth()),
+                Optional.of(source.getColorLogic()), Optional.of(source.getVertexFormat()), Optional.of(mode)))
+            .withLocation(id("pipeline/" + name))
+            .withDepthBias(source.getDepthBiasScaleFactor(), source.getDepthBiasConstant());
+    }
+
+    private static final RenderPipeline UI_COLOR = basicPipeline("ui_color", "core/position_color", DefaultVertexFormat.POSITION_COLOR, QUADS)
+        .withBlend(BlendFunction.TRANSLUCENT).build();
