+    private static final RenderType ITEM_WHITE_TYPE = create("item_afterimage",
+        RenderSetup.builder(ITEM_WHITE).withTexture("Sampler0", WHITE).useLightmap().affectsCrumbling().sortOnUpload());
+    private static final Function<Identifier, RenderType> ENTITY_STENCIL_TYPE = Util.memoize(texture ->
+        create("entity_particle_stencil", RenderSetup.builder(ENTITY_STENCIL).withTexture("Sampler0", texture)));
+    private static final RenderType ITEM_STENCIL_TYPE = create("item_particle_stencil",
+        RenderSetup.builder(ITEM_STENCIL).withTexture("Sampler0", TextureAtlas.LOCATION_BLOCKS));
+    private static final RenderType BLOCK_HIGHLIGHT_TYPE = create("block_highlight",
+        RenderSetup.builder(BLOCK_HIGHLIGHT).withTexture("Sampler0", WHITE).useLightmap().sortOnUpload());
