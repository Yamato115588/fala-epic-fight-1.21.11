+    private static final RenderPipeline OVERLAY = entityEffectPipeline("overlay_model", TRIANGLES);
+    private static final RenderPipeline ENTITY_PARTICLE = entityEffectPipeline("entity_particle", TRIANGLES);
+    private static final RenderPipeline ITEM_PARTICLE = entityEffectPipeline("item_particle", QUADS);
+    private static final RenderPipeline ENTITY_WHITE = whiteAfterimagePipeline("entity_afterimage", TRIANGLES);
+    private static final RenderPipeline ITEM_WHITE = whiteAfterimagePipeline("item_afterimage", QUADS);
+    private static final RenderPipeline ENTITY_STENCIL = texturePipeline("entity_particle_stencil", TRIANGLES).withColorWrite(false).build();
+    private static final RenderPipeline ITEM_STENCIL = texturePipeline("item_particle_stencil", QUADS).withColorWrite(false).build();
+    private static final RenderPipeline BLOCK_HIGHLIGHT = copyPipeline(RenderPipelines.TRANSLUCENT_MOVING_BLOCK, "block_highlight", QUADS)
+        .withDepthTestFunction(EQUAL_DEPTH_TEST).withDepthWrite(true).build();
+    private static final RenderPipeline COLORED_GLINT = copyPipeline(RenderPipelines.GLINT, "colored_glint", TRIANGLES)
+        .withFragmentShader(id("core/colored_glint")).withCull(false).build();
+
+    private static RenderPipeline.Builder basicPipeline(String name, String shader, VertexFormat format, VertexFormat.Mode mode) {
+        return RenderPipeline.builder().withLocation(id("pipeline/" + name))
+            .withVertexShader(shader).withFragmentShader(shader)
+            .withUniform("DynamicTransforms", UniformType.UNIFORM_BUFFER)
+            .withUniform("Projection", UniformType.UNIFORM_BUFFER)
+            .withDepthTestFunction(DepthTestFunction.LEQUAL_DEPTH_TEST)
+            .withVertexFormat(format, mode);
+    }
+
+    private static RenderPipeline.Builder texturePipeline(String name, VertexFormat.Mode mode) {
