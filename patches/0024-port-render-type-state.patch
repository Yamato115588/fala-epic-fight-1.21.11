+    private record ColoredGlint(RenderType type, Vector3f tint) {
+    }
+
+    private static final Map<Entity, ColoredGlint> WORLD_GLINT = new IdentityHashMap<>();
+
+    public static void freeUnusedWorldRenderTypes() {
+        WORLD_GLINT.keySet().removeIf(Entity::isRemoved);
+    }
+
+    public static void clearWorldRenderTypes() {
+        WORLD_GLINT.clear();
+    }
+
+    public static RenderType coloredGlintWorldRendertype(Entity owner, float r, float g, float b) {
+        ColoredGlint glint = WORLD_GLINT.computeIfAbsent(owner, entity -> {
+            Vector3f tint = new Vector3f(1.0F);
+            // Glint vertices use vec4(UV, 0, 1). Column 2 is available for the per-draw tint.
+            TextureTransform transform = new TextureTransform("epicfight:glint_tint", () ->
+                TextureTransform.ENTITY_GLINT_TEXTURING.getMatrix().m20(tint.x).m21(tint.y).m22(tint.z));
+            Supplier<GpuSampler> sampler = () -> RenderSystem.getSamplerCache().getRepeat(FilterMode.LINEAR);
+            RenderType type = create("colored_glint", RenderSetup.builder(COLORED_GLINT)
+                .withTexture("Sampler0", GLINT_WHITE, sampler).setTextureTransform(transform));
+            return new ColoredGlint(type, tint);
+        });
+        glint.tint().set(r, g, b);
+        return glint.type();
+    }
