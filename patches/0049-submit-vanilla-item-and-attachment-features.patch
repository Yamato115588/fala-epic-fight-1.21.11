diff --git a/src/main/java/yesman/epicfight/client/renderer/VanillaRenderSubmissions.java b/src/main/java/yesman/epicfight/client/renderer/VanillaRenderSubmissions.java
new file mode 100644
index 0000000..7b9442e
--- /dev/null
+++ b/src/main/java/yesman/epicfight/client/renderer/VanillaRenderSubmissions.java
@@ -0,0 +1,61 @@
+package yesman.epicfight.client.renderer;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.renderer.MultiBufferSource;
+import net.minecraft.client.renderer.SubmitNodeStorage;
+import net.minecraft.client.renderer.entity.layers.RenderLayer;
+import net.minecraft.client.renderer.feature.ItemFeatureRenderer;
+import net.minecraft.client.renderer.feature.ModelFeatureRenderer;
+import net.minecraft.client.renderer.feature.ModelPartFeatureRenderer;
+import net.minecraft.client.renderer.item.ItemStackRenderState;
+import net.minecraft.client.renderer.texture.OverlayTexture;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.item.ItemDisplayContext;
+import net.minecraft.world.item.ItemStack;
+
+/** Render vanilla submissions inside Epic Fight's animated joints and poses. */
+public final class VanillaRenderSubmissions {
+    private VanillaRenderSubmissions() {}
+
+    public static void drawItem(LivingEntity entity, ItemStack stack, ItemDisplayContext view,
+                                PoseStack pose, MultiBufferSource output, int light) {
+        var model = new ItemStackRenderState();
+        Minecraft.getInstance().getItemModelResolver().updateForLiving(model, stack, view, entity);
+        var submissions = new SubmitNodeStorage();
+        model.submit(pose, submissions, light, OverlayTexture.NO_OVERLAY, 0);
+        draw(submissions, output);
+    }
+
+    @SuppressWarnings({"rawtypes", "unchecked"})
+    public static void drawLayer(RenderLayer<?, ?> layer, LivingEntity entity, PoseStack pose,
+                                 MultiBufferSource output, int light, float yaw, float pitch, float partialTick) {
+        var submissions = new SubmitNodeStorage();
+        var renderer = Minecraft.getInstance().getEntityRenderDispatcher().getRenderer(entity);
+        ((RenderLayer)layer).submit(pose, submissions, light, renderer.createRenderState(entity, partialTick), yaw, pitch);
+        draw(submissions, output);
+    }
+
+    public static <E extends Entity> void drawEntity(E entity, PoseStack pose, MultiBufferSource output, float partialTick) {
+        var mc = Minecraft.getInstance();
+        var levelState = mc.gameRenderer.getLevelRenderState();
+        var dispatcher = mc.getEntityRenderDispatcher();
+        var renderState = dispatcher.getRenderer(entity).createRenderState(entity, partialTick);
+        var submissions = new SubmitNodeStorage();
+        dispatcher.submit(renderState, levelState.cameraRenderState, 0, 0, 0, pose, submissions);
+        draw(submissions, output);
+    }
+
+    public static void draw(SubmitNodeStorage submissions, MultiBufferSource output) {
+        var renderBuffers = Minecraft.getInstance().renderBuffers();
+        var buffers = output instanceof MultiBufferSource.BufferSource source ? source : renderBuffers.bufferSource();
+        var outline = renderBuffers.outlineBufferSource();
+        var crumble = renderBuffers.crumblingBufferSource();
+        for (var group : submissions.getSubmitsPerOrder().values()) {
+            new ModelFeatureRenderer().render(group, buffers, outline, crumble);
+            new ModelPartFeatureRenderer().render(group, buffers, outline, crumble);
+            new ItemFeatureRenderer().render(group, buffers, outline);
+        }
+    }
+}
