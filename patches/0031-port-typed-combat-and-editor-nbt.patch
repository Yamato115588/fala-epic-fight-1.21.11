 package yesman.epicfight.util;
 
 import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.DoubleTag;
+import net.minecraft.nbt.IntTag;
+import net.minecraft.nbt.ListTag;
+import net.minecraft.nbt.NumericTag;
+import net.minecraft.nbt.StringTag;
 import net.minecraft.nbt.Tag;
 
 import java.util.function.Supplier;
 
 public final class TagUtils {
+    private static final int ANY_NUMERIC = 99;
+
     public static <T extends Tag> T getOrCreateTag(CompoundTag root, String key, Supplier<T> tagProvider) {
         if (root.contains(key)) {
             return (T)root.get(key);
@@ -16,6 +23,43 @@ public final class TagUtils {
         return tag;
     }
 
+    /** Return the live list only when its elements have the requested legacy NBT type. */
+    public static ListTag getTypedList(CompoundTag compound, String key, int elementType) {
+        ListTag list = compound.getListOrEmpty(key);
+        for (Tag element : list) {
+            if (element.getId() != elementType) return new ListTag();
+        }
+        return list;
+    }
+
+    public static boolean containsType(CompoundTag compound, String key, int type) {
+        Tag value = compound.get(key);
+        if (type == ANY_NUMERIC) return value instanceof NumericTag;
+        return (value == null ? Tag.TAG_END : value.getId()) == type;
+    }
+
+    /** Strings are unquoted for editing. Other tag values use their SNBT representation. */
+    public static String stringValue(Tag value) {
+        return value instanceof StringTag string ? string.value() : value.toString();
+    }
+
+    public static String stringAt(ListTag list, int index) {
+        Tag value = elementAt(list, index);
+        return value == null ? "" : stringValue(value);
+    }
+
+    public static double doubleAt(ListTag list, int index) {
+        return elementAt(list, index) instanceof DoubleTag value ? value.doubleValue() : 0.0D;
+    }
+
+    public static int intAt(ListTag list, int index) {
+        return elementAt(list, index) instanceof IntTag value ? value.intValue() : 0;
+    }
+
+    private static Tag elementAt(ListTag list, int index) {
+        return index >= 0 && index < list.size() ? list.get(index) : null;
+    }
+
     private TagUtils() {
     }
 }
