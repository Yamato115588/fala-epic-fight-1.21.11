+package yesman.epicfight.client.gui.widgets;
+
+import com.mojang.blaze3d.ProjectionType;
+import com.mojang.blaze3d.pipeline.TextureTarget;
+import com.mojang.blaze3d.platform.Lighting;
+import com.mojang.blaze3d.systems.RenderSystem;
+import com.mojang.blaze3d.textures.FilterMode;
+import com.mojang.blaze3d.vertex.BufferBuilder;
+import com.mojang.blaze3d.vertex.ByteBufferBuilder;
+import com.mojang.blaze3d.vertex.PoseStack;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphics;
+import net.minecraft.client.renderer.CachedPerspectiveProjectionMatrixBuffer;
+import net.minecraft.client.renderer.LightTexture;
+import net.minecraft.client.renderer.MultiBufferSource;
+import net.minecraft.client.renderer.OutlineBufferSource;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.client.renderer.SubmitNodeStorage;
+import net.minecraft.client.renderer.feature.FeatureRenderDispatcher;
+import net.minecraft.client.renderer.item.ItemStackRenderState;
+import net.minecraft.client.renderer.rendertype.RenderType;
+import net.minecraft.client.renderer.texture.OverlayTexture;
+import net.minecraft.util.ARGB;
+import net.minecraft.world.item.ItemDisplayContext;
+import net.minecraft.world.item.ItemStack;
+
+/** Off-screen rendering shared by the model editor and datapack preview. */
+public final class PreviewRenderTarget implements AutoCloseable {
+    private final TextureTarget target = new TextureTarget("Epic Fight preview", 8, 8, true);
+    private final CachedPerspectiveProjectionMatrixBuffer projection =
+        new CachedPerspectiveProjectionMatrixBuffer("Epic Fight preview", 0.05F, 100.0F);
+    private int clearColor = ARGB.colorFromFloat(1.0F, 0.1552F, 0.1552F, 0.1552F);
+    private ByteBufferBuilder itemVertices;
+    private MultiBufferSource.BufferSource itemBuffers;
+    private FeatureRenderDispatcher itemFeatures;
+
+    public void setClearColor(float red, float green, float blue, float alpha) {
+        this.clearColor = ARGB.colorFromFloat(alpha, red, green, blue);
+    }
+
+    public void resize(int width, int height) {
+        if (target.width != width || target.height != height) {
+            target.resize(width, height);
+        }
+    }
+
+    public void draw(Runnable content) {
+        var previousColor = RenderSystem.outputColorTextureOverride;
+        var previousDepth = RenderSystem.outputDepthTextureOverride;
+        var previousProjection = RenderSystem.getProjectionMatrixBuffer();
+        var previousProjectionType = RenderSystem.getProjectionType();
+        var previousLights = RenderSystem.getShaderLights();
+        var modelView = RenderSystem.getModelViewStack();
+        modelView.pushMatrix();
+        try {
+            modelView.identity();
+            RenderSystem.setProjectionMatrix(projection.getBuffer(target.width, target.height, 50.0F), ProjectionType.PERSPECTIVE);
+            RenderSystem.outputColorTextureOverride = target.getColorTextureView();
+            RenderSystem.outputDepthTextureOverride = target.getDepthTextureView();
+            RenderSystem.getDevice().createCommandEncoder().clearColorAndDepthTextures(
+                target.getColorTexture(), clearColor, target.getDepthTexture(), 1.0D);
+            Minecraft.getInstance().gameRenderer.getLighting().setupFor(Lighting.Entry.ITEMS_3D);
+            content.run();
+        } finally {
+            RenderSystem.outputColorTextureOverride = previousColor;
+            RenderSystem.outputDepthTextureOverride = previousDepth;
+            RenderSystem.setProjectionMatrix(previousProjection, previousProjectionType);
+            RenderSystem.setShaderLights(previousLights);
+            modelView.popMatrix();
+        }
+    }
+
+    public void submitToGui(GuiGraphics graphics, int x, int y, int width, int height) {
+        graphics.submitBlit(RenderPipelines.GUI_TEXTURED, target.getColorTextureView(),
+            RenderSystem.getSamplerCache().getClampToEdge(FilterMode.NEAREST),
+            x, x + width, y, y + height, 0.0F, 1.0F, 1.0F, 0.0F, -1);
+    }
+
+    public static void drawMesh(RenderType type, BufferBuilder builder) {
+        var data = builder.build();
+        if (data != null) {
+            type.draw(data);
+        }
+    }
+
+    public void drawItem(ItemStack stack, PoseStack pose) {
+        Minecraft client = Minecraft.getInstance();
+        if (itemFeatures == null) {
+            itemVertices = new ByteBufferBuilder(65536);
+            itemBuffers = MultiBufferSource.immediate(itemVertices);
+            itemFeatures = new FeatureRenderDispatcher(new SubmitNodeStorage(), client.getBlockRenderer(),
+                itemBuffers, client.getAtlasManager(), new OutlineBufferSource(), itemBuffers, client.font);
+        }
+
+        var storage = itemFeatures.getSubmitNodeStorage();
+        ItemStackRenderState state = new ItemStackRenderState();
+        client.getItemModelResolver().updateForTopItem(state, stack, ItemDisplayContext.THIRD_PERSON_RIGHT_HAND,
+            client.level, null, 0);
+        try {
+            state.submit(pose, storage, LightTexture.FULL_BRIGHT, OverlayTexture.NO_OVERLAY, 0);
+            itemFeatures.renderAllFeatures();
+            itemBuffers.endBatch();
+        } finally {
+            storage.clear();
+        }
+    }
+
+    @Override
+    public void close() {
+        target.destroyBuffers();
+        projection.close();
+        if (itemFeatures != null) {
+            itemFeatures.close();
+            itemVertices.close();
+            itemFeatures = null;
+        }
+    }
+}
