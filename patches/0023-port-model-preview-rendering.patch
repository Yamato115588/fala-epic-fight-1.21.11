+package yesman.epicfight.client.renderer;
+
+import java.util.function.Function;
+
+import com.mojang.blaze3d.pipeline.BlendFunction;
+import com.mojang.blaze3d.pipeline.RenderPipeline;
+import com.mojang.blaze3d.platform.DepthTestFunction;
+import com.mojang.blaze3d.shaders.UniformType;
+import com.mojang.blaze3d.systems.RenderSystem;
+import com.mojang.blaze3d.textures.FilterMode;
+import com.mojang.blaze3d.vertex.DefaultVertexFormat;
+import com.mojang.blaze3d.vertex.VertexFormat;
+import net.minecraft.client.renderer.rendertype.RenderSetup;
+import net.minecraft.client.renderer.rendertype.RenderType;
+import net.minecraft.resources.Identifier;
+import net.minecraft.util.Util;
+
+public final class PreviewRenderTypes {
+    private static final Identifier SHADER = Identifier.fromNamespaceAndPath("epicfight", "core/preview_model");
+    private static final RenderPipeline SOLID = modelPipeline("solid", DefaultVertexFormat.POSITION_COLOR_NORMAL)
+        .withUniform("Lighting", UniformType.UNIFORM_BUFFER).build();
+    private static final RenderPipeline TEXTURED = modelPipeline("textured", DefaultVertexFormat.POSITION_TEX_COLOR_NORMAL)
+        .withUniform("Lighting", UniformType.UNIFORM_BUFFER)
+        .withSampler("Sampler0").withShaderDefine("TEXTURED").build();
+    private static final RenderPipeline TRAIL = modelPipeline("trail", DefaultVertexFormat.POSITION_TEX_COLOR)
+        .withSampler("Sampler0").withShaderDefine("TEXTURED").withShaderDefine("UNLIT")
+        .withVertexFormat(DefaultVertexFormat.POSITION_TEX_COLOR, VertexFormat.Mode.QUADS)
+        .withBlend(BlendFunction.TRANSLUCENT).withDepthWrite(false).build();
+
+    private static final RenderType SOLID_MODEL =
+        RenderType.create("epicfight:preview_solid", RenderSetup.builder(SOLID).createRenderSetup());
+    private static final Function<Identifier, RenderType> TEXTURED_MODEL = Util.memoize(texture ->
+        RenderType.create("epicfight:preview_textured", RenderSetup.builder(TEXTURED)
+            .withTexture("Sampler0", texture).createRenderSetup()));
+    private static final Function<Identifier, RenderType> TEXTURED_TRAIL = Util.memoize(texture ->
+        RenderType.create("epicfight:preview_trail", RenderSetup.builder(TRAIL)
+            .withTexture("Sampler0", texture, () -> RenderSystem.getSamplerCache().getClampToEdge(FilterMode.LINEAR))
+            .createRenderSetup()));
+
+    private PreviewRenderTypes() {
+    }
+
+    public static RenderType model(Identifier texture) {
+        return texture == null ? SOLID_MODEL : TEXTURED_MODEL.apply(texture);
+    }
+
+    public static RenderType trail(Identifier texture) {
+        return TEXTURED_TRAIL.apply(texture);
+    }
+
+    private static RenderPipeline.Builder modelPipeline(String name, VertexFormat format) {
+        return RenderPipeline.builder()
+            .withLocation(Identifier.fromNamespaceAndPath("epicfight", "pipeline/preview_" + name))
+            .withVertexShader(SHADER).withFragmentShader(SHADER)
+            .withUniform("DynamicTransforms", UniformType.UNIFORM_BUFFER)
+            .withUniform("Projection", UniformType.UNIFORM_BUFFER)
+            .withDepthTestFunction(DepthTestFunction.LEQUAL_DEPTH_TEST)
+            .withDepthWrite(true).withCull(false)
+            .withVertexFormat(format, VertexFormat.Mode.TRIANGLES);
+    }
+}
