+#version 330
+
+in vec4 vertexColor;
+out vec4 fragColor;
+
+#ifdef TEXTURED
+uniform sampler2D Sampler0;
+in vec2 texCoord;
+#endif
+
+void main() {
+    vec4 color = vertexColor;
+#ifdef TEXTURED
+    color *= texture(Sampler0, texCoord);
+    if (color.a < 0.1) discard;
+#endif
+    fragColor = color;
+}
