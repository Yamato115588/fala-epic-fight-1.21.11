+    public static <T, C extends ModConfigSpec.ConfigValue<T>> ConfigurableGameRule<T, C> create(
+            String name, GameRuleCategory category, Function<ModConfigSpec.Builder, C> configDefinition,
+            RuleType<T> type, boolean synchronize) {
+        return new ConfigurableGameRule<>(name, category, configDefinition, type, synchronize);
+    }
+
+    public static class ConfigurableGameRule<T, C extends ModConfigSpec.ConfigValue<T>> {
+        private final String ruleName;
+        private final GameRuleCategory ruleCategory;
+        private final Function<ModConfigSpec.Builder, C> configDefinition;
+        private final RuleType<T> ruleType;
+        private final boolean synchronize;
+        private final Map<Level, T> clientValues = new WeakHashMap<>();
+        private C configValueHolder;
+        private GameRule<T> gameRuleKey;
+
+        private ConfigurableGameRule(String name, GameRuleCategory category, Function<ModConfigSpec.Builder, C> configDefinition,
+                                     RuleType<T> type, boolean synchronize) {
+            this.ruleName = name;
+            this.ruleCategory = category;
+            this.configDefinition = configDefinition;
+            this.ruleType = type;
+            this.synchronize = synchronize;
+        }
+
+        public Identifier identifier() {
+            String path = CaseFormat.LOWER_CAMEL.to(CaseFormat.LOWER_UNDERSCORE, this.ruleName.replace("UI", "Ui"));
+            return Identifier.fromNamespaceAndPath("epicfight", path);
+        }
+
+        public void registerGameRule() {
+            this.gameRuleKey = this.ruleType.builder().apply(this.configValueHolder.get())
+                    .category(this.ruleCategory).buildAndRegister(this.identifier());
+            if (this.synchronize) {
+                GameRuleEvents.changeCallback(this.gameRuleKey).register((value, server) ->
+                        EpicFightNetworkManager.sendToAll(server, this.syncPacket(value)));
+            }
+        }
+
+        public boolean shouldSync() {
+            return this.synchronize;
+        }
+
+        public SPChangeGamerule getSyncPacket(ServerPlayer player) {
+            return this.syncPacket(this.getRuleValue(player.level()));
+        }
+
+        @SuppressWarnings("unchecked")
+        private SPChangeGamerule syncPacket(T value) {
+            return new SPChangeGamerule(new KeyValuePair((ConfigurableGameRule<Object, ?>)this, value));
+        }
+
+        public void defineConfig(ModConfigSpec.Builder configBuilder) {
+            this.configValueHolder = this.configDefinition.apply(configBuilder);
+        }
+
+        public String getRuleName() {
+            return this.ruleName;
+        }
+
+        public RuleType<T> getRuleType() {
+            return this.ruleType;
+        }
+
+        public GameRule<T> getRuleKey() {
+            return this.gameRuleKey;
+        }
+
+        public C getConfigHolder() {
+            return this.configValueHolder;
+        }
+
+        public T getRuleValue(Level level) {
+            if (level instanceof ServerLevel serverLevel) {
+                return serverLevel.getGameRules().get(this.gameRuleKey);
+            }
+            return this.clientValues.getOrDefault(level, this.gameRuleKey.defaultValue());
+        }
+
+        public void setRuleValue(Level level, T value) {
+            if (level instanceof ServerLevel serverLevel) {
+                serverLevel.getGameRules().set(this.gameRuleKey, value, serverLevel.getServer());
+            } else {
+                this.clientValues.put(level, value);
+            }
+        }
+
+        public void copyClientValue(Level from, Level to) {
+            this.setRuleValue(to, this.getRuleValue(from));
+        }
+    }
+
+    public record RuleType<T>(Function<T, GameRuleBuilder<T>> builder, StreamCodec<ByteBuf, T> codec) {
+        private static final RuleType<Boolean> BOOLEAN = new RuleType<>(GameRuleBuilder::forBoolean, ByteBufCodecs.BOOL);
+        private static final RuleType<Integer> INTEGER = new RuleType<>(GameRuleBuilder::forInteger, ByteBufCodecs.INT);
+    }
+
+    public record KeyValuePair(ConfigurableGameRule<Object, ?> gamerule, Object value) {
+    }
+}
