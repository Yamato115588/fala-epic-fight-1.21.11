@@ -0,0 +1,71 @@
+package yesman.epicfight.client.gui;
+
+import com.mojang.blaze3d.pipeline.RenderPipeline;
+import com.mojang.blaze3d.vertex.VertexConsumer;
+import com.mojang.blaze3d.vertex.VertexFormat;
+import java.util.List;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphics;
+import net.minecraft.client.gui.navigation.ScreenRectangle;
+import net.minecraft.client.gui.render.TextureSetup;
+import net.minecraft.client.gui.render.state.GuiElementRenderState;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.resources.Identifier;
+import net.minecraft.world.phys.Vec2;
+import org.joml.Matrix3x2f;
+
+public final class GuiGeometry {
+    private static final RenderPipeline TEXTURED_TRIANGLES = RenderPipeline.builder(RenderPipelines.GUI_TEXTURED_SNIPPET)
+        .withLocation(Identifier.fromNamespaceAndPath("epicfight", "pipeline/gui_textured_triangles"))
+        .withVertexFormat(RenderPipelines.GUI_TEXTURED.getVertexFormat(), VertexFormat.Mode.TRIANGLES).withCull(false).build();
+
+    private GuiGeometry() {}
+
+    public static void horizontalGradient(GuiGraphics graphics, int x1, int y1, int x2, int y2, int left, int right) {
+        graphics.pose().pushMatrix().translate(x1, y1).rotate((float)(-Math.PI / 2));
+        graphics.fillGradient(y1 - y2, 0, 0, x2 - x1, left, right);
+        graphics.pose().popMatrix();
+    }
+
+    public static void diamond(GuiGraphics graphics, int left, int top, int right, int bottom, int color) {
+        float scale = (float)(1 / Math.sqrt(8));
+        graphics.pose().pushMatrix().translate((left + right) * 0.5F, (top + bottom) * 0.5F)
+            .scale((right - left) * scale, (bottom - top) * scale).rotate((float)(Math.PI / 4));
+        graphics.fill(-1, -1, 1, 1, color);
+        graphics.pose().popMatrix();
+    }
+
+    public static void texturedFan(GuiGraphics graphics, Identifier texture, float x, float y, float size, int color, List<Vec2> texels) {
+        var image = Minecraft.getInstance().getTextureManager().getTexture(texture);
+        var transform = new Matrix3x2f(graphics.pose());
+        var scissor = graphics.scissorStack.peek();
+        int left = (int)Math.floor(x);
+        int top = (int)Math.floor(y);
+        int right = (int)Math.ceil(x + size);
+        int bottom = (int)Math.ceil(y + size);
+        var bounds = new ScreenRectangle(left, top, right - left, bottom - top).transformMaxBounds(transform);
+        if (scissor != null) bounds = bounds.intersection(scissor);
+        if (bounds != null) {
+            graphics.guiRenderState.submitGuiElement(new Fan(TextureSetup.singleTexture(image.getTextureView(), image.getSampler()),
+                scissor, bounds, transform, x, y, size, color, List.copyOf(texels)));
+        }
+    }
+
+    private record Fan(TextureSetup textureSetup, ScreenRectangle scissorArea, ScreenRectangle bounds,
+                       Matrix3x2f pose, float x, float y, float size, int color, List<Vec2> vertices) implements GuiElementRenderState {
+        @Override public RenderPipeline pipeline() { return TEXTURED_TRIANGLES; }
+
+        @Override public void buildVertices(VertexConsumer consumer) {
+            Vec2 center = vertices.getFirst();
+            for (int i = 1; i + 1 < vertices.size(); i++) {
+                vertex(consumer, center);
+                vertex(consumer, vertices.get(i));
+                vertex(consumer, vertices.get(i + 1));
+            }
+        }
+
+        private void vertex(VertexConsumer consumer, Vec2 uv) {
+            consumer.addVertexWith2DPose(pose, x + size * uv.x, y + size * uv.y).setUv(uv.x, uv.y).setColor(color);
+        }
+    }
+}
