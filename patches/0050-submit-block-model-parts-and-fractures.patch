+public class FractureBlockRenderer implements BlockEntityRenderer<FractureBlockEntity, FractureBlockRenderer.State> {
+    private final BlockRenderDispatcher blockRenderDispatcher;
+
+    public FractureBlockRenderer(BlockEntityRendererProvider.Context context) {
+        this.blockRenderDispatcher = context.blockRenderDispatcher();
+    }
+
+    @Override
+    public State createRenderState() {
+        return new State();
+    }
+
+    @Override
+    public void extractRenderState(FractureBlockEntity block, State state, float partialTick, Vec3 camera,
+        ModelFeatureRenderer.CrumblingOverlay crumbling) {
+        BlockEntityRenderer.super.extractRenderState(block, state, partialTick, camera, crumbling);
+        state.original = block.getOriginalBlockState();
+        state.level = block.getLevel();
+
+        float turnBackTime = 5.0F;
+        float remaining = block.getMaxLifeTime() - block.getLifeTime();
+        float progress = Mth.clamp((partialTick + turnBackTime - remaining) / turnBackTime, 0.0F, 1.0F);
+        state.translation = new Vector3f(block.getTranslate());
+        state.rotation = new Quaternionf(block.getRotation());
+        if (remaining <= turnBackTime) {
+            state.translation = MathUtils.lerpMojangVector(state.translation, new Vector3f(), progress);
+            state.rotation = MathUtils.lerpQuaternion(state.rotation, new Quaternionf(), progress);
+        }
+
+        double height = block.getBouncing();
+        double duration = Math.max(height * 8.0D, 8.0D);
+        double curvature = 1.0D / Math.pow(duration * 0.5D, 2.0D);
+        double apex = Math.sqrt(height / curvature);
+        state.bounce = Math.max(height - curvature * Math.pow(block.getLifeTime() + partialTick - apex, 2.0D), 0.0D);
+    }
+
+    @Override
+    public void submit(State state, PoseStack poses, SubmitNodeCollector collector, CameraRenderState camera) {
+        if (state.level == null || state.original == null) {
+            return;
+        }
+
+        poses.pushPose();
+        poses.translate(0.5D, 0.5D, 0.5D);
+        poses.mulPose(state.rotation);
+        poses.translate(state.translation.x(), state.translation.y() + state.bounce, state.translation.z());
+        poses.translate(-0.5D, -0.5D, -0.5D);
+
+        var pos = state.blockPos.above();
+        var original = state.original;
+        var level = state.level;
+        collector.submitCustomGeometry(poses, RenderTypes.cutoutMovingBlock(), (pose, vertices) -> {
+            PoseStack blockPoses = new PoseStack();
+            blockPoses.last().set(pose);
+            this.blockRenderDispatcher.renderBreakingTexture(original, pos, level, blockPoses, vertices);
+        });
+        poses.popPose();
+    }
+
+    public static class State extends BlockEntityRenderState {
+        private BlockState original;
+        private Level level;
+        private Vector3f translation;
+        private Quaternionf rotation;
+        private double bounce;
+    }
+}
