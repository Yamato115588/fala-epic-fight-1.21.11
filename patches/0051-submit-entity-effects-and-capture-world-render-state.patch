+@Mixin(ThrownTridentRenderer.class)
+abstract class MixinThrownTridentRenderer {
+    @WrapOperation(
+        method = "submit(Lnet/minecraft/client/renderer/entity/state/ThrownTridentRenderState;Lcom/mojang/blaze3d/vertex/PoseStack;Lnet/minecraft/client/renderer/SubmitNodeCollector;Lnet/minecraft/client/renderer/state/CameraRenderState;)V",
+        at = @At(value = "INVOKE", target = "Lcom/mojang/blaze3d/vertex/PoseStack;mulPose(Lorg/joml/Quaternionfc;)V", ordinal = 0))
+    private void epicfight$applyReturnOrientation(PoseStack poses, Quaternionfc usual, Operation<Void> original,
+        ThrownTridentRenderState state, @Share("returning") LocalBooleanRef returning) {
+        if (((EntityRenderSource)state).epicfight$entity() instanceof ThrownTrident trident) {
+            ThrownTridentPatch patch = EpicFightCapabilities.getEntityPatch(trident, ThrownTridentPatch.class);
+            if (patch != null && patch.isInnateActivated() && trident.getOwner() != null) {
+                Vec3 towardOwner = trident.getOwner().position().subtract(trident.position());
+                if (towardOwner.lengthSqr() > 1.0E-8D) {
+                    double flat = towardOwner.horizontalDistance();
+                    Vec3 axis = flat > 1.0E-5D ? new Vec3(-towardOwner.z(), 0.0D, towardOwner.x()).scale(Math.signum(towardOwner.y()) / flat)
+                        : new Vec3(1.0D, 0.0D, 0.0D);
+                    if (towardOwner.y() != 0.0D) {
+                        float tilt = (float)Math.toDegrees(Math.atan2(Math.abs(towardOwner.y()), flat));
+                        poses.mulPose(QuaternionUtils.rotationDegrees(new Vector3f((float)axis.x(), (float)axis.y(), (float)axis.z()), tilt));
+                    }
+                    poses.mulPose(QuaternionUtils.XP.rotationDegrees(90.0F));
+                    returning.set(true);
+                    return;
+                }
+            }
+        }
+        original.call(poses, usual);
+    }
+
+    @WrapOperation(
+        method = "submit(Lnet/minecraft/client/renderer/entity/state/ThrownTridentRenderState;Lcom/mojang/blaze3d/vertex/PoseStack;Lnet/minecraft/client/renderer/SubmitNodeCollector;Lnet/minecraft/client/renderer/state/CameraRenderState;)V",
+        at = @At(value = "INVOKE", target = "Lcom/mojang/blaze3d/vertex/PoseStack;mulPose(Lorg/joml/Quaternionfc;)V", ordinal = 1))
+    private void epicfight$moveReturnModel(PoseStack poses, Quaternionfc usual, Operation<Void> original,
+        @Share("returning") LocalBooleanRef returning) {
+        original.call(poses, usual);
+        if (returning.get()) {
+            poses.translate(0.0D, -0.8D, 0.0D);
+        }
+    }
+}
