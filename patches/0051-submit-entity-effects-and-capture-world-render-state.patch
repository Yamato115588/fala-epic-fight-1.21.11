+    public void submit(ItemEntityRenderState state, PoseStack poses, SubmitNodeCollector collector, CameraRenderState camera) {
+        super.submit(state, poses, collector, camera);
+        float progression = state.ageInTicks * 0.01F;
+        float pulse = (Mth.sin(progression * 5.0F) + 1.0F) * 0.5F;
