+package yesman.epicfight.client.renderer;
+
+import java.util.List;
+import java.util.UUID;
+import net.fabricmc.loader.api.FabricLoader;
+import yesman.epicfight.api.client.render.VanillaPlayerModelPolicy;
+
+public final class VanillaPlayerModelOverrides {
+    private static final List<VanillaPlayerModelPolicy> POLICIES = FabricLoader.getInstance()
+        .getEntrypoints(VanillaPlayerModelPolicy.ENTRYPOINT, VanillaPlayerModelPolicy.class);
+
+    private VanillaPlayerModelOverrides() {
+    }
+
+    public static boolean keepVanillaModel(UUID playerId) {
+        for (var policy : POLICIES) {
+            if (policy.keepVanillaModel(playerId)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+}
