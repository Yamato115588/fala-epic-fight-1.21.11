+package yesman.epicfight.world.gamerule;
+
+import com.mojang.serialization.Dynamic;
+
+/** Converts the saved Epic Fight entries left in the game_rules map by Minecraft's data fixer. */
+public final class LegacyGameRules {
+    private LegacyGameRules() {}
+
+    public static <T> Dynamic<T> migrate(Dynamic<T> levelData) {
+        Dynamic<T> original = levelData.get("game_rules").orElseEmptyMap();
+        Dynamic<T> rules = original;
+        for (var rule : EpicFightGameRules.GAME_RULES.values()) {
+            rules = migrateRule(rules, rule);
+        }
+        return rules == original ? levelData : levelData.set("game_rules", rules);
+    }
+
+    private static <T, V> Dynamic<T> migrateRule(Dynamic<T> rules, EpicFightGameRules.ConfigurableGameRule<V, ?> rule) {
+        String oldName = rule.getRuleName();
+        var oldValue = rules.get(oldName).result();
+        var key = rule.getRuleKey();
+        if (oldValue.isEmpty() || key == null) {
+            return rules;
+        }
+
+        String newName = rule.identifier().toString();
+        if (rules.get(newName).result().isPresent()) {
+            return rules.remove(oldName);
+        }
+        var ops = rules.getOps();
+        var converted = oldValue.get().asString().result()
+                .flatMap(value -> key.deserialize(value).result())
+                .flatMap(value -> key.valueCodec().encodeStart(ops, value).result());
+        Dynamic<T> cleaned = rules.remove(oldName);
+        return converted.map(value -> cleaned.set(newName, new Dynamic<>(ops, value))).orElse(cleaned);
+    }
+}
