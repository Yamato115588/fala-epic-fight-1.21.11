+package yesman.epicfight.client.model;
+
+import com.google.gson.JsonObject;
+import java.io.StringReader;
+import java.util.EnumMap;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.client.renderer.block.model.BlockModel;
+import net.minecraft.client.renderer.item.BlockModelWrapper;
+import net.minecraft.client.renderer.item.ItemModel;
+import net.minecraft.client.renderer.item.ModelRenderProperties;
+import net.minecraft.client.resources.model.BlockModelRotation;
+import net.minecraft.client.resources.model.ModelBaker;
+import net.minecraft.client.resources.model.ResolvableModel;
+import net.minecraft.client.resources.model.ResolvedModel;
+import net.minecraft.client.resources.model.UnbakedModel;
+import net.minecraft.resources.Identifier;
+import net.minecraft.world.item.ItemDisplayContext;
+
+/** Resolve the inline base and perspective sections of a licensed legacy item model. */
+record SeparateTransformsUnbakedModel(Identifier item, BlockModel base, Map<ItemDisplayContext, BlockModel> perspectives) {
+    static final String LOADER = "neoforge:separate_transforms";
+
+    static SeparateTransformsUnbakedModel parse(Identifier id, JsonObject model) {
+        if (!model.has("loader")) return new SeparateTransformsUnbakedModel(id, readPart(model, model), Map.of());
+        if (!LOADER.equals(model.get("loader").getAsString())) return null;
+        Map<ItemDisplayContext, BlockModel> perspectives = new EnumMap<>(ItemDisplayContext.class);
+        JsonObject sections = model.getAsJsonObject("perspectives");
+        if (sections != null) {
+            for (ItemDisplayContext view : ItemDisplayContext.values()) {
+                BlockModel section = readPart(sections.getAsJsonObject(view.getSerializedName()), model);
+                if (section != null) perspectives.put(view, section);
+            }
+        }
+        BlockModel base = readPart(model.getAsJsonObject("base"), model);
+        return base == null && perspectives.isEmpty() ? null : new SeparateTransformsUnbakedModel(id, base, Map.copyOf(perspectives));
+    }
+
+    private static BlockModel readPart(JsonObject part, JsonObject parent) {
+        if (part == null) return null;
+        if (parent.has("gui_light") && !part.has("gui_light")) {
+            part = part.deepCopy();
+            part.add("gui_light", parent.get("gui_light"));
+        }
+        return BlockModel.fromStream(new StringReader(part.toString()));
+    }
+
+    void resolveDependencies(ResolvableModel.Resolver resolver) {
+        registerParent(resolver, base);
+        for (BlockModel model : perspectives.values()) registerParent(resolver, model);
+    }
+
+    private static void registerParent(ResolvableModel.Resolver resolver, BlockModel model) {
+        if (model != null && model.parent() != null) resolver.markDependency(model.parent());
+    }
+
+    ItemModel bake(ModelBaker baker) {
+        ItemModel baseItem = base == null ? null : bakePart(baker, base, item + " base");
+        if (perspectives.isEmpty()) return baseItem;
+        Map<ItemDisplayContext, ItemModel> overrides = new EnumMap<>(ItemDisplayContext.class);
+        perspectives.forEach((context, model) -> overrides.put(context, bakePart(baker, model, item + " " + context.getSerializedName())));
+        return new SeparateTransformsBakedModel(baseItem, Map.copyOf(overrides));
+    }
+
+    private static ItemModel bakePart(ModelBaker baker, BlockModel part, String name) {
+        ResolvedModel parent = part.parent() == null ? null : baker.getModel(part.parent());
+        ResolvedModel model = new InlinePart(part, parent, name);
+        var textures = model.getTopTextureSlots();
+        var quads = model.bakeTopGeometry(textures, baker, BlockModelRotation.IDENTITY).getAll();
+        var properties = ModelRenderProperties.fromResolvedModel(baker, model, textures);
+        return new BlockModelWrapper(List.of(), quads, properties, BlockModelWrapper.detectRenderType(quads));
+    }
+
+    private record InlinePart(UnbakedModel wrapped, ResolvedModel parent, String debugName) implements ResolvedModel {}
+}
