+package yesman.epicfight.client.model;
+
+import com.google.gson.JsonParser;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.CompletableFuture;
+import java.util.stream.Collectors;
+import net.fabricmc.fabric.api.client.model.loading.v1.ExtraModelKey;
+import net.fabricmc.fabric.api.client.model.loading.v1.FabricBakedModelManager;
+import net.fabricmc.fabric.api.client.model.loading.v1.PreparableModelLoadingPlugin;
+import net.fabricmc.fabric.api.client.model.loading.v1.UnbakedExtraModel;
+import net.minecraft.client.renderer.item.ItemModel;
+import net.minecraft.client.resources.model.ModelBaker;
+import net.minecraft.client.resources.model.ModelManager;
+import net.minecraft.client.resources.model.ResolvableModel;
+import net.minecraft.resources.FileToIdConverter;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.resources.ResourceManager;
+import yesman.epicfight.EpicFight;
+import yesman.epicfight.skill.SkillCategory;
+
+public final class SeparateTransformsModelLoadingPlugin {
+    private static final FileToIdConverter MODELS = FileToIdConverter.json("models/item");
+    private static final ExtraModelKey<Map<Identifier, ItemModel>> MODELS_BY_ITEM = ExtraModelKey.create(() -> "Epic Fight legacy item models");
+
+    public static void register() {
+        PreparableModelLoadingPlugin.register((state, executor) -> CompletableFuture.supplyAsync(() -> load(state.resourceManager()), executor),
+            (models, context) -> context.addModel(MODELS_BY_ITEM, new ItemModels(models)));
+    }
+
+    public static ItemModel getLegacyModel(ModelManager manager, Identifier item) {
+        var models = ((FabricBakedModelManager)manager).getModel(MODELS_BY_ITEM);
+        return models == null ? null : models.get(item);
+    }
+
+    private static Map<Identifier, SeparateTransformsUnbakedModel> load(ResourceManager resources) {
+        Set<Identifier> bookIcons = SkillCategory.ENUM_MANAGER.universalValues().stream()
+            .map(SkillCategory::bookIcon).collect(Collectors.toSet());
+        bookIcons.add(SkillCategory.DEFAULT_BOOK_ICON);
+        Map<Identifier, SeparateTransformsUnbakedModel> models = new HashMap<>();
+        MODELS.listMatchingResources(resources).forEach((id, resource) -> {
+            Identifier item = MODELS.fileToId(id);
+            if (!item.getNamespace().equals(EpicFight.MODID) && !bookIcons.contains(item)) return;
+            try (var reader = resource.openAsReader()) {
+                var model = SeparateTransformsUnbakedModel.parse(item, JsonParser.parseReader(reader).getAsJsonObject());
+                if (model != null) models.put(item, model);
+            } catch (Exception ex) {
+                EpicFight.LOGGER.warn("Could not read legacy item model {}", id, ex);
+            }
+        });
+        return Map.copyOf(models);
+    }
+
+    private record ItemModels(Map<Identifier, SeparateTransformsUnbakedModel> entries) implements UnbakedExtraModel<Map<Identifier, ItemModel>> {
+        @Override
+        public void resolveDependencies(ResolvableModel.Resolver resolver) {
+            entries.values().forEach(model -> model.resolveDependencies(resolver));
+        }
+
+        @Override
+        public Map<Identifier, ItemModel> bake(ModelBaker baker) {
+            Map<Identifier, ItemModel> items = new HashMap<>();
+            entries.forEach((item, model) -> items.put(item, model.bake(baker)));
+            return Map.copyOf(items);
+        }
+    }
+}
