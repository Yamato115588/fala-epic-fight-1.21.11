+++ b/src/main/java/yesman/epicfight/client/renderer/EpicFightColorRenderTypes.java
@@ -0,0 +1,46 @@
+package yesman.epicfight.client.renderer;
+
+import com.mojang.blaze3d.pipeline.BlendFunction;
+import com.mojang.blaze3d.pipeline.RenderPipeline;
+import com.mojang.blaze3d.platform.DepthTestFunction;
+import com.mojang.blaze3d.shaders.UniformType;
+import com.mojang.blaze3d.vertex.DefaultVertexFormat;
+import com.mojang.blaze3d.vertex.VertexFormat;
+import net.minecraft.client.renderer.rendertype.LayeringTransform;
+import net.minecraft.client.renderer.rendertype.OutputTarget;
+import net.minecraft.client.renderer.rendertype.RenderSetup;
+import net.minecraft.client.renderer.rendertype.RenderType;
+import net.minecraft.resources.Identifier;
+
+final class EpicFightColorRenderTypes {
+    static final RenderType COLLIDER = RenderType.create("epicfight:debug_collider", RenderSetup.builder(
+        colorPipeline("debug_collider", "core/position_color", DefaultVertexFormat.POSITION_COLOR_NORMAL, VertexFormat.Mode.DEBUG_LINE_STRIP)
+            .withCull(false).withBlend(BlendFunction.TRANSLUCENT).build())
+        .setLayeringTransform(LayeringTransform.VIEW_OFFSET_Z_LAYERING)
+        .setOutputTarget(OutputTarget.ITEM_ENTITY_TARGET).bufferSize(256).createRenderSetup());
+
+    static final RenderType QUADS = RenderType.create("epicfight:debug_quad", RenderSetup.builder(
+        colorPipeline("debug_quad", "core/position_color", DefaultVertexFormat.POSITION_COLOR, VertexFormat.Mode.QUADS)
+            .withCull(false).build())
+        .setLayeringTransform(LayeringTransform.VIEW_OFFSET_Z_LAYERING).bufferSize(256).createRenderSetup());
+
+    static final RenderType GUI_TRIANGLE = RenderType.create("epicfight:gui_triangle", RenderSetup.builder(
+        colorPipeline("gui_triangle", "core/gui", DefaultVertexFormat.POSITION_COLOR, VertexFormat.Mode.TRIANGLES)
+            .withBlend(BlendFunction.TRANSLUCENT).build())
+        .bufferSize(256).createRenderSetup());
+
+    private EpicFightColorRenderTypes() {
+    }
+
+    private static RenderPipeline.Builder colorPipeline(String name, String shader, VertexFormat format, VertexFormat.Mode mode) {
+        return RenderPipeline.builder()
+            .withLocation(Identifier.fromNamespaceAndPath("epicfight", "pipeline/" + name))
+            .withVertexShader(shader)
+            .withFragmentShader(shader)
+            .withUniform("DynamicTransforms", UniformType.UNIFORM_BUFFER)
+            .withUniform("Projection", UniformType.UNIFORM_BUFFER)
+            .withDepthTestFunction(DepthTestFunction.LEQUAL_DEPTH_TEST)
+            .withDepthWrite(true)
+            .withVertexFormat(format, mode);
+    }
+}
