+    private static final Logger LOGGER = LogUtils.getLogger();
+    private final String url;
+    private volatile byte[] bytes;
+    private CompletableFuture<Void> download;
+    private boolean closed;
+
+    public RemoteTexture(String url, Identifier fallback) {
+        super(fallback);
+        this.url = url;
+    }
+
+    @Override
+    public synchronized TextureContents loadContents(ResourceManager resources) throws IOException {
+        if (this.bytes != null) return new TextureContents(NativeImage.read(new ByteArrayInputStream(this.bytes)), null);
+        if (this.download == null) this.download = CompletableFuture.runAsync(this::download, Util.backgroundExecutor());
+        try {
+            return super.loadContents(resources);
+        } catch (java.io.FileNotFoundException missing) {
+            return TextureContents.createMissing();
+        }
+    }
+
+    private void download() {
+        HttpURLConnection connection = null;
+        try {
+            connection = (HttpURLConnection)URI.create(this.url).toURL().openConnection(Minecraft.getInstance().getProxy());
+            connection.setConnectTimeout(10_000);
+            connection.setReadTimeout(15_000);
+            if (connection.getResponseCode() / 100 != 2) throw new IOException("HTTP " + connection.getResponseCode());
+            byte[] content;
+            try (var input = connection.getInputStream()) {
+                content = input.readAllBytes();
+            }
+            NativeImage image = NativeImage.read(new ByteArrayInputStream(content));
+            this.bytes = content;
+            Minecraft.getInstance().execute(() -> {
+                try (var texture = new TextureContents(image, null)) {
+                    if (!closed) this.apply(texture);
+                }
+            });
+        } catch (IOException | IllegalArgumentException exception) {
+            LOGGER.warn("Could not load remote texture {}", this.url, exception);
+        } finally {
+            if (connection != null) connection.disconnect();
+        }
+    }
+
+    @Override
+    public void close() {
+        this.closed = true;
+        super.close();
+    }
+}
