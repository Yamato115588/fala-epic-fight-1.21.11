@@ -0,0 +1,84 @@
+package yesman.epicfight.world.item;
+
+import java.util.List;
+
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.ToolMaterial;
+
+public final class WeaponMaterials {
+    private static final List<ToolMaterial> VANILLA_MATERIALS = List.of(
+        ToolMaterial.WOOD, ToolMaterial.STONE, ToolMaterial.COPPER, ToolMaterial.IRON,
+        ToolMaterial.GOLD, ToolMaterial.DIAMOND, ToolMaterial.NETHERITE
+    );
+
+    private WeaponMaterials() {
+    }
+
+    public static ToolMaterial materialOf(Item item) {
+        if (item instanceof TieredWeaponItem weapon) {
+            return weapon.getMaterial();
+        }
+
+        var components = item.components();
+        var repairable = components.get(DataComponents.REPAIRABLE);
+        if (!components.has(DataComponents.TOOL) || repairable == null) {
+            return null;
+        }
+
+        var repairTag = repairable.items().unwrapKey().orElse(null);
+        int durability = components.getOrDefault(DataComponents.MAX_DAMAGE, 0);
+        for (var material : VANILLA_MATERIALS) {
+            if (material.durability() == durability && material.repairItems().equals(repairTag)) {
+                return material;
+            }
+        }
+
+        return null;
+    }
+
+    public static int level(Item item) {
+        return level(item, materialOf(item));
+    }
+
+    public static int level(Item item, ToolMaterial material) {
+        if (material != null) {
+            return level(material);
+        }
+
+        var components = item.components();
+        if (isMaterialTool(item)) {
+            return levelFromDurability(components.getOrDefault(DataComponents.MAX_DAMAGE, 0));
+        }
+        return 0;
+    }
+
+    public static boolean isMaterialTool(Item item) {
+        var components = item.components();
+        return components.has(DataComponents.TOOL) && components.has(DataComponents.REPAIRABLE);
+    }
+
+    public static int level(ToolMaterial material) {
+        if (material == ToolMaterial.WOOD || material == ToolMaterial.GOLD) {
+            return 0;
+        }
+        if (material == ToolMaterial.STONE) {
+            return 1;
+        }
+        if (material == ToolMaterial.IRON) {
+            return 2;
+        }
+        if (material == ToolMaterial.DIAMOND) {
+            return 3;
+        }
+        if (material == ToolMaterial.NETHERITE) {
+            return 4;
+        }
+        return levelFromDurability(material.durability());
+    }
+
+    private static int levelFromDurability(int durability) {
+        double sqrt = Math.sqrt(durability);
+        return sqrt < 10.0D ? 0 : (int)Math.round(sqrt / 10.0D);
+    }
+}
