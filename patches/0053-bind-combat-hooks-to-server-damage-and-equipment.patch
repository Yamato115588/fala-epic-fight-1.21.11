+package yesman.epicfight.mixin.common;
+
+import java.util.function.BiConsumer;
+
+import net.minecraft.core.Holder;
+import net.minecraft.world.entity.EquipmentSlot;
+import net.minecraft.world.entity.EquipmentSlotGroup;
+import net.minecraft.world.entity.ai.attributes.Attribute;
+import net.minecraft.world.entity.ai.attributes.AttributeModifier;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.component.ItemAttributeModifiers;
+import org.apache.commons.lang3.function.TriConsumer;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Unique;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+import yesman.epicfight.api.event.impl.VanillaItemEventHooks;
+
+@Mixin(ItemStack.class)
+abstract class MixinItemStack {
+    @Inject(method = "forEachModifier(Lnet/minecraft/world/entity/EquipmentSlotGroup;Lorg/apache/commons/lang3/function/TriConsumer;)V", at = @At("HEAD"))
+    private void epicfight$tooltipModifiers(EquipmentSlotGroup group, TriConsumer<Holder<Attribute>, AttributeModifier, ItemAttributeModifiers.Display> consumer, CallbackInfo ci) {
+        if (group == EquipmentSlotGroup.MAINHAND) {
+            epicfight$mainHandModifiers((attribute, modifier) -> consumer.accept(attribute, modifier, ItemAttributeModifiers.Display.attributeModifiers()));
+        }
+    }
+
+    @Inject(method = "forEachModifier(Lnet/minecraft/world/entity/EquipmentSlot;Ljava/util/function/BiConsumer;)V", at = @At("HEAD"))
+    private void epicfight$equipmentModifiers(EquipmentSlot slot, BiConsumer<Holder<Attribute>, AttributeModifier> consumer, CallbackInfo ci) {
+        if (slot == EquipmentSlot.MAINHAND) {
+            epicfight$mainHandModifiers(consumer);
+        }
+    }
+
+    @Unique
+    private void epicfight$mainHandModifiers(BiConsumer<Holder<Attribute>, AttributeModifier> consumer) {
+        VanillaItemEventHooks.onModifyItemAttribute((ItemStack)(Object)this, (attribute, modifier, slot) -> {
+            if (slot == EquipmentSlotGroup.MAINHAND) {
+                consumer.accept(attribute, modifier);
+            }
+        });
+    }
+}
