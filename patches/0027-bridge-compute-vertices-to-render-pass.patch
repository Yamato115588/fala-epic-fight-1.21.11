+package yesman.epicfight.client.renderer.shader.compute;
+
+import java.util.Arrays;
+import java.util.IdentityHashMap;
+import java.util.Map;
+import java.util.OptionalDouble;
+import java.util.OptionalInt;
+
+import org.joml.Vector3f;
+import org.joml.Vector4f;
+import org.lwjgl.opengl.GL15C;
+import org.lwjgl.opengl.GL20C;
+import org.lwjgl.opengl.GL30C;
+import org.lwjgl.opengl.GL43C;
+
+import com.mojang.blaze3d.buffers.GpuBuffer;
+import com.mojang.blaze3d.opengl.GlBuffer;
+import com.mojang.blaze3d.systems.RenderSystem;
+import com.mojang.blaze3d.vertex.VertexFormat;
+import com.mojang.blaze3d.vertex.VertexFormatElement;
+
+import net.minecraft.client.renderer.rendertype.RenderSetup;
+import net.minecraft.client.renderer.rendertype.RenderType;
+import yesman.epicfight.client.renderer.shader.compute.backend.program.ComputeProgram;
+
+final class ComputeVertexBuffer implements AutoCloseable {
+    private static final int MAX_VERTEX_BYTES = 128;
+    private static final int MID_UV_BASE = 64;
+    private static final int PACKED_COLOR_BASE = 80;
+    private static final int SSBO = GL43C.GL_SHADER_STORAGE_BUFFER;
+    private static final int GROUP_SIZE = 128;
+    private static final Vector4f WHITE = new Vector4f(1.0F);
+    private static final Vector3f ZERO = new Vector3f();
+
+    private final Map<VertexFormat, int[]> layouts = new IdentityHashMap<>();
+    private GpuBuffer vertices;
+
+    static int[] mapLayout(VertexFormat format, int sourceStride, boolean iris) {
+        int stride = format.getVertexSize();
+        if (stride == 0 || stride > MAX_VERTEX_BYTES) {
+            throw new IllegalArgumentException("Unsupported compute vertex stride: " + stride);
+        }
+        int[] layout = new int[stride];
+        Arrays.fill(layout, -1);
+        for (VertexFormatElement element : format.getElements()) {
+            int source;
+            int size;
+            if (element == VertexFormatElement.POSITION) {
+                source = 0;
+                size = 12;
+            } else if (element == VertexFormatElement.COLOR) {
+                source = PACKED_COLOR_BASE;
+                size = 4;
+            } else if (element == VertexFormatElement.UV0) {
+                source = 28;
+                size = 8;
+            } else if (element == VertexFormatElement.NORMAL) {
+                source = 36;
+                size = 3;
+            } else if (element == VertexFormatElement.UV1) {
+                source = 40;
+                size = 4;
+            } else if (element == VertexFormatElement.UV2) {
+                source = 44;
+                size = 4;
+            } else if (iris) {
+                String name = format.getElementName(element);
+                switch (name) {
+                    case "iris_Entity" -> {
+                        source = 48;
+                        size = 6;
+                    }
+                    case "mc_midTexCoord" -> {
+                        source = MID_UV_BASE;
+                        size = 8;
+                    }
+                    case "at_tangent" -> {
+                        source = 56;
+                        size = 4;
+                    }
+                    default -> throw new IllegalArgumentException("Unsupported Iris compute vertex attribute: " + name);
+                }
+            } else {
+                throw new IllegalArgumentException("Unsupported compute vertex attribute: " + format.getElementName(element));
+            }
+            if (element.byteSize() != size || (source < MID_UV_BASE && source + size > sourceStride)) {
+                throw new IllegalArgumentException("Unexpected compute vertex attribute layout: " + element);
+            }
+            int offset = format.getOffset(element);
+            for (int index = 0; index < size; index++) {
+                layout[offset + index] = source + index;
+            }
+        }
+        return layout;
+    }
+
+    void draw(ComputeProgram packer, RenderType type, int source, int sourceStride, int irisMidUv, int count) {
+        if (type.mode() != VertexFormat.Mode.TRIANGLES) {
+            throw new IllegalArgumentException("GPU skinning requires triangle geometry: " + type);
+        }
+        int[] layout = this.layouts.computeIfAbsent(type.format(), format -> mapLayout(format, sourceStride, irisMidUv != 0));
+        long byteCount = (long) layout.length * count;
+        long wordCount = (byteCount + Integer.BYTES - 1) / Integer.BYTES;
+        long allocation = wordCount * Integer.BYTES;
+        if (this.vertices == null || this.vertices.size() < allocation) {
+            GpuBuffer replacement = RenderSystem.getDevice().createBuffer(() -> "Epic Fight skinned vertices", GpuBuffer.USAGE_VERTEX, allocation);
+            this.close();
+            this.vertices = replacement;
+        }
+
+        // This buffer belongs to Minecraft's OpenGL device. SSBO writes target
+        // the same allocation that RenderPass uses for vertex attribute fetch.
+        int oldSource = GL30C.glGetIntegeri(GL43C.GL_SHADER_STORAGE_BUFFER_BINDING, 0);
+        int oldDestination = GL30C.glGetIntegeri(GL43C.GL_SHADER_STORAGE_BUFFER_BINDING, 1);
+        int oldMidUv = GL30C.glGetIntegeri(GL43C.GL_SHADER_STORAGE_BUFFER_BINDING, 2);
+        int oldBinding = GL15C.glGetInteger(GL43C.GL_SHADER_STORAGE_BUFFER_BINDING);
+        try {
+            packer.useProgram();
+            packer.getUniform("vertexCount").uploadUnsignedInt(count);
+            packer.getUniform("sourceWords").uploadUnsignedInt(sourceStride / Integer.BYTES);
+            packer.getUniform("targetStride").uploadUnsignedInt(layout.length);
+            GL20C.glUniform1iv(packer.getUniformLocation("byteSources"), layout);
+            GL30C.glBindBufferBase(SSBO, 0, source);
+            GL30C.glBindBufferBase(SSBO, 1, ((GlBuffer) this.vertices).handle);
+            GL30C.glBindBufferBase(SSBO, 2, irisMidUv == 0 ? source : irisMidUv);
+            // The skinning dispatch writes the raw SSBO. It must be visible
+            // before this dispatch reads it, and before a previous draw is reused.
+            GL43C.glMemoryBarrier(GL43C.GL_SHADER_STORAGE_BARRIER_BIT);
+            packer.dispatch(Math.toIntExact((wordCount + GROUP_SIZE - 1) / GROUP_SIZE), 1, 1);
+            // Vertex fetch sees the newly packed bytes without a CPU transfer.
+            packer.memBarriers();
+        } finally {
+            GL30C.glBindBufferBase(SSBO, 0, oldSource);
+            GL30C.glBindBufferBase(SSBO, 1, oldDestination);
+            GL30C.glBindBufferBase(SSBO, 2, oldMidUv);
+            GL15C.glBindBuffer(SSBO, oldBinding);
+        }
+        this.render(type, count);
+    }
+
+    private void render(RenderType type, int count) {
+        RenderSetup setup = type.state;
+        var matrix = RenderSystem.getModelViewStack();
+        var layering = setup.layeringTransform.getModifier();
+        if (layering != null) {
+            matrix.pushMatrix();
+        }
+        try {
+            if (layering != null) {
+                layering.accept(matrix);
+            }
+            var transform = RenderSystem.getDynamicUniforms()
+                .writeTransform(matrix, WHITE, ZERO, setup.textureTransform.getMatrix());
+            var target = setup.outputTarget.getRenderTarget();
+            var color = RenderSystem.outputColorTextureOverride != null
+                ? RenderSystem.outputColorTextureOverride : target.getColorTextureView();
+            var depth = target.useDepth
+                ? RenderSystem.outputDepthTextureOverride != null
+                    ? RenderSystem.outputDepthTextureOverride : target.getDepthTextureView()
+                : null;
+            var scissor = RenderSystem.getScissorStateForRenderTypeDraws();
+            try (var pass = RenderSystem.getDevice().createCommandEncoder()
+                    .createRenderPass(type::toString, color, OptionalInt.empty(), depth, OptionalDouble.empty())) {
+                pass.setPipeline(type.pipeline());
+                if (scissor.enabled()) {
+                    pass.enableScissor(scissor.x(), scissor.y(), scissor.width(), scissor.height());
+                }
+                RenderSystem.bindDefaultUniforms(pass);
+                pass.setUniform("DynamicTransforms", transform);
+                setup.getTextures().forEach((name, binding) -> pass.bindTexture(name, binding.textureView(), binding.sampler()));
+                pass.setVertexBuffer(0, this.vertices);
+                // The mesh transformer emits every vertex of every triangle in
+                // final draw order, so there is no index buffer to reconstruct.
+                pass.draw(0, count);
+            }
+        } finally {
+            if (layering != null) {
+                matrix.popMatrix();
+            }
+        }
+    }
+
+    @Override
+    public void close() {
+        if (this.vertices != null) {
+            this.vertices.close();
+            this.vertices = null;
+        }
+    }
+}
