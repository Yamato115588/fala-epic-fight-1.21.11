diff --git a/src/main/resources/assets/epicfight/shaders/compute/vertex_buffer_pack.comp b/src/main/resources/assets/epicfight/shaders/compute/vertex_buffer_pack.comp
new file mode 100644
--- /dev/null
+++ b/src/main/resources/assets/epicfight/shaders/compute/vertex_buffer_pack.comp
@@ -0,0 +1,63 @@
+#version 430 core
+
+layout(local_size_x = 128) in;
+layout(std430, binding = 0) readonly buffer SkinningResult { uint source[]; };
+layout(std430, binding = 1) writeonly buffer VertexBuffer { uint target[]; };
+layout(std430, binding = 2) readonly buffer IrisMidUv { uint midUv[]; };
+
+uniform uint vertexCount;
+uniform uint sourceWords;
+uniform uint targetStride;
+uniform int byteSources[128];
+
+uint sourceByte(int selector, uint vertex, uint packedColor) {
+    if (selector < 0) return 0u;
+    if (selector >= 80) return (packedColor >> (8 * (selector - 80))) & 255u;
+    uint value;
+    if (selector >= 64) {
+        value = midUv[vertex * 2u + uint(selector - 64) / 4u];
+    } else {
+        value = source[vertex * sourceWords + uint(selector) / 4u];
+    }
+    return (value >> (8 * (selector & 3))) & 255u;
+}
+
+uint packedColorAt(uint vertex) {
+    uint base = vertex * sourceWords;
+    return packUnorm4x8(uintBitsToFloat(uvec4(source[base + 3u], source[base + 4u],
+        source[base + 5u], source[base + 6u])));
+}
+
+void main() {
+    uint word = gl_GlobalInvocationID.x;
+    uint firstByte = word * 4u;
+    uint byteCount = vertexCount * targetStride;
+    if (firstByte >= byteCount) return;
+
+    uint vertex = firstByte / targetStride;
+    uint lane = firstByte % targetStride;
+    int first = byteSources[lane];
+    if (lane + 3u < targetStride && first >= 0 && first < 64 && (first & 3) == 0 &&
+            byteSources[lane + 1u] == first + 1 && byteSources[lane + 2u] == first + 2 &&
+            byteSources[lane + 3u] == first + 3) {
+        target[word] = source[vertex * sourceWords + uint(first) / 4u];
+        return;
+    }
+
+    // Iris can use a stride that is not a multiple of four. One invocation
+    // owns the whole destination word, even across two adjacent vertices.
+    uint value = 0u;
+    uint colorVertex = ~0u;
+    uint packedColor = 0u;
+    for (uint byte = 0u; byte < 4u && firstByte + byte < byteCount; ++byte) {
+        uint address = firstByte + byte;
+        vertex = address / targetStride;
+        int selector = byteSources[address % targetStride];
+        if (selector >= 80 && vertex != colorVertex) {
+            packedColor = packedColorAt(vertex);
+            colorVertex = vertex;
+        }
+        value |= sourceByte(selector, vertex, packedColor) << (byte * 8u);
+    }
+    target[word] = value;
+}
