@@ -0,0 +1,33 @@
+package yesman.epicfight.client.renderer;
+
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.components.debug.DebugScreenEntries;
+import net.minecraft.client.model.EntityModel;
+import net.minecraft.client.renderer.entity.LivingEntityRenderer;
+import net.minecraft.client.renderer.entity.state.LivingEntityRenderState;
+import net.minecraft.world.entity.LivingEntity;
+import yesman.epicfight.api.extension.EntityExtension;
+import yesman.epicfight.mixin.client.MixinLivingEntityRenderer;
+
+public final class EntityRenderFeatures {
+    private EntityRenderFeatures() {}
+
+    public static boolean showHitboxes() {
+        return Minecraft.getInstance().debugEntries.isCurrentlyEnabled(DebugScreenEntries.ENTITY_HITBOXES);
+    }
+
+    public static boolean upsideDown(LivingEntity entity) {
+        var renderer = Minecraft.getInstance().getEntityRenderDispatcher().getRenderer(entity);
+        return renderer instanceof LivingEntityRenderer<?, ?, ?> living && ((MixinLivingEntityRenderer)living).invokeIsEntityUpsideDown(entity);
+    }
+
+    @SuppressWarnings({"unchecked", "rawtypes"})
+    public static void prepareModel(EntityModel<?> model, LivingEntity entity, LivingEntityRenderState state, float partialTick) {
+        if (model == null) return;
+        if (entity.getVehicle() != null && !EntityExtension.of(entity.getVehicle()).epicfight$shouldRiderSit() && entity.isAlive()) {
+            state.walkAnimationSpeed = entity.walkAnimation.speed(partialTick);
+            state.walkAnimationPos = entity.walkAnimation.position(partialTick);
+        }
+        ((EntityModel)model).setupAnim(state);
+    }
+}
