+package yesman.epicfight.client.renderer;
+
+import java.util.List;
+import java.util.function.Consumer;
+import net.minecraft.client.renderer.MultiBufferSource;
+import net.minecraft.client.renderer.SubmitNodeCollector;
+
+public interface EntityRenderTasks {
+    List<Consumer<MultiBufferSource.BufferSource>> epicfight$entityDraws();
+
+    static void submit(SubmitNodeCollector collector, Consumer<MultiBufferSource.BufferSource> draw) {
+        ((EntityRenderTasks)collector.order(0)).epicfight$entityDraws().add(draw);
+    }
+}
