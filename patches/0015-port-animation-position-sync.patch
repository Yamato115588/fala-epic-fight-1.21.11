@@ -0,0 +1,32 @@
+package yesman.epicfight.network;
+
+import net.minecraft.world.entity.InterpolationHandler;
+import net.minecraft.world.phys.Vec3;
+
+final class AnimationPositionSync {
+    private AnimationPositionSync() {
+    }
+
+    static void apply(InterpolationHandler interpolation, Vec3 position, int steps) {
+        if (interpolation == null) {
+            return;
+        }
+
+        float yaw = interpolation.yRot();
+        float pitch = interpolation.xRot();
+        // An identical target must still restart with the duration carried by this packet.
+        interpolation.cancel();
+
+        if (steps <= 0) {
+            return;
+        }
+
+        int previousLength = interpolation.interpolationSteps;
+        interpolation.setInterpolationLength(steps);
+        try {
+            interpolation.interpolateTo(position, yaw, pitch);
+        } finally {
+            interpolation.setInterpolationLength(previousLength);
+        }
+    }
+}
