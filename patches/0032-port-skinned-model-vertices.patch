+package yesman.epicfight.api.client.model.transformer;
+
+import net.minecraft.client.model.geom.ModelPart;
+import net.minecraft.core.Vec3i;
+import org.jetbrains.annotations.ApiStatus;
+import org.joml.Matrix4fc;
+import org.joml.Vector3f;
+
+/** Model-space position and UV while splitting armor polygons at joint-weight boundaries. */
+@ApiStatus.Internal
+public class MeshVertex {
+    public final Vector3f pos;
+    public final float u;
+    public final float v;
+
+    public MeshVertex(Vector3f pos, float u, float v) {
+        this.pos = pos;
+        this.u = u;
+        this.v = v;
+    }
+
+    public MeshVertex(float x, float y, float z, float u, float v) {
+        this(new Vector3f(x, y, z), u, v);
+    }
+
+    public static MeshVertex transform(ModelPart.Vertex vertex, Matrix4fc matrix) {
+        Vector3f position = matrix.transformPosition(vertex.x(), vertex.y(), vertex.z(), new Vector3f());
+        return new MeshVertex(position, vertex.u(), vertex.v());
+    }
+
+    public static final class AnimatedVertex extends MeshVertex {
+        public final Vec3i jointId;
+        public final Vector3f weight;
+
+        public AnimatedVertex(MeshVertex source, int joint) {
+            this(source, joint, 0, 0, 1.0F, 0.0F, 0.0F);
+        }
+
+        public AnimatedVertex(MeshVertex source, int first, int second, int third, float w1, float w2, float w3) {
+            this(source, source.u, source.v, new Vec3i(first, second, third), new Vector3f(w1, w2, w3));
+        }
+
+        public AnimatedVertex(MeshVertex source, float u, float v, Vec3i joints, Vector3f weights) {
+            super(new Vector3f(source.pos), u, v);
+            this.jointId = joints;
+            this.weight = weights;
+        }
+    }
+}
