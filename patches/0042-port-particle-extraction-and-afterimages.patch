+package yesman.epicfight.client.particle;
+
+import com.mojang.blaze3d.pipeline.BlendFunction;
+import com.mojang.blaze3d.pipeline.RenderPipeline;
+import com.mojang.blaze3d.vertex.DefaultVertexFormat;
+import com.mojang.blaze3d.vertex.VertexFormat;
+import java.util.function.Function;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.client.renderer.rendertype.RenderSetup;
+import net.minecraft.client.renderer.rendertype.RenderType;
+import net.minecraft.resources.Identifier;
+import net.minecraft.util.Util;
+
+final class ParticleEffectPipelines {
+    private static final RenderPipeline TEXTURED_MODEL = RenderPipeline.builder(RenderPipelines.PARTICLE_SNIPPET)
+        .withLocation(id("pipeline/model_particle")).withBlend(BlendFunction.TRANSLUCENT)
+        .withCull(false).withDepthWrite(true)
+        .withVertexFormat(DefaultVertexFormat.PARTICLE, VertexFormat.Mode.TRIANGLES).build();
+    private static final Function<Identifier, RenderType> MODEL_TEXTURES = Util.memoize(texture ->
+        RenderType.create("epicfight:model_particle", RenderSetup.builder(TEXTURED_MODEL)
+            .withTexture("Sampler0", texture).useLightmap().createRenderSetup()));
+    private static final RenderPipeline GLOWING = RenderPipeline.builder(RenderPipelines.DEBUG_FILLED_SNIPPET)
+        .withLocation(id("pipeline/glowing_particle")).withBlend(BlendFunction.TRANSLUCENT)
+        .withCull(false).withDepthWrite(true)
+        .withVertexFormat(DefaultVertexFormat.POSITION_COLOR, VertexFormat.Mode.TRIANGLES).build();
+    static final RenderType GLOWING_MODEL = RenderType.create("epicfight:glowing_particle", RenderSetup.builder(GLOWING).createRenderSetup());
+    private static final RenderPipeline ADDITIVE = RenderPipeline.builder(RenderPipelines.MATRICES_FOG_SNIPPET)
+        .withLocation(id("pipeline/particle_lightning")).withVertexShader("core/rendertype_lightning")
+        .withFragmentShader("core/rendertype_lightning").withBlend(BlendFunction.LIGHTNING).withDepthWrite(false)
+        .withVertexFormat(DefaultVertexFormat.POSITION_COLOR, VertexFormat.Mode.TRIANGLES).build();
+    static final RenderType LIGHTNING_MODEL = RenderType.create("epicfight:lightning_particle", RenderSetup.builder(ADDITIVE).createRenderSetup());
+
+    private ParticleEffectPipelines() {}
+
+    static RenderType texturedModel(Identifier texture) {
+        return MODEL_TEXTURES.apply(texture);
+    }
+
+    private static Identifier id(String location) {
+        return Identifier.fromNamespaceAndPath("epicfight", location);
+    }
+}
